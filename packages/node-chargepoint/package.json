{
	"name": "node-chargepoint",
	"version": "0.12.3",
	"description": "A Node.js/TypeScript wrapper for the ChargePoint EV charging network API. Based on python-chargepoint by Marc Billow.",
	"keywords": [
		"chargepoint",
		"ev",
		"electric-vehicle",
		"charging",
		"evse"
	],
	"homepage": "https://github.com/musicbender/zeal/tree/main/packages/node-chargepoint#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/musicbender/zeal.git",
		"directory": "packages/node-chargepoint"
	},
	"bugs": {
		"url": "https://github.com/musicbender/zeal/issues"
	},
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"bin": {
		"chargepoint": "./dist/cli.cjs"
	},
	"files": [
		"dist",
		"LICENSE"
	],
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit",
		"lint": "eslint src tests --max-warnings 0",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "vitest run --config vitest.e2e.config.ts"
	},
	"engines": {
		"node": ">=22"
	},
	"dependencies": {
		"commander": "^12.1.0"
	},
	"devDependencies": {
		"@repo/eslint-config": "workspace:*",
		"@repo/typescript-config": "workspace:*",
		"@types/node": "^22.0.0",
		"eslint": "^9.31.0",
		"msw": "^2.7.0",
		"tsup": "^8.5.1",
		"typescript": "5.5.4",
		"vitest": "^4.1.0"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
